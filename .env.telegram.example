# Shared secret. Must match TELEGRAM_SERVICE_TOKEN in Django .env.
TELEGRAM_SERVICE_TOKEN=

# Django base URL visible from telegram-service.
# Local Docker: http://web:8000
# Separate server: https://your-django-host.example
TELEGRAM_DJANGO_BASE_URL=http://web:8000

# Worker settings.
TELEGRAM_WORKER_ID=telegram-worker-local-1
TELEGRAM_WORKER_POLLING_INTERVAL=5
TELEGRAM_WORKER_LEASE_SECONDS=120

# Telegram bot tokens.
TG_TOKEN_USERS=
TG_TOKEN_ADMIN=
TG_TOKEN_MAIL=
TG_CHAT_ID_MAIL=

# Logging.
LOG_LEVEL=INFO
